{
    "env": {
      "browser": true,
      "es2021": true
    },
    "extends": [
      "eslint:recommended",
      "plugin:react/recommended"
    ],
    "plugins": ["react"],
    "rules": {
      "react/no-unescaped-entities": "error"
    },
    "settings": {
      "react": {
        "version": "detect"
      }
    }
  }